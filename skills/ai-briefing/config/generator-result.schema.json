{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issueDate", "candidatePath", "selectionPath", "selfReviewPath", "coverageConclusion", "selfReviewConclusion"],
      "properties": {
        "status": { "const": "draft_ready" },
        "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "candidatePath": { "type": "string", "minLength": 1 },
        "selectionPath": { "type": "string", "minLength": 1 },
        "selfReviewPath": { "type": "string", "minLength": 1 },
        "coverageConclusion": { "enum": ["sufficient", "degraded"] },
        "selfReviewConclusion": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issueDate", "selectionPath", "selfReviewPath", "coverageConclusion", "reason"],
      "properties": {
        "status": { "const": "no_events" },
        "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "selectionPath": { "type": "string", "minLength": 1 },
        "selfReviewPath": { "type": "string", "minLength": 1 },
        "coverageConclusion": { "const": "sufficient" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issueDate", "reason", "blockers"],
      "properties": {
        "status": { "const": "blocked" },
        "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason": { "type": "string", "minLength": 1 },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issueDate", "reason"],
      "properties": {
        "status": { "const": "failed" },
        "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
